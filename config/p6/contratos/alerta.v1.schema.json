{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p6/alerta.v1",
  "title": "Alerta investigable (Proyecto 6, v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "alert_id", "rule_id", "run_id", "timestamp_utc", "severidad", "motivo",
    "accion_sugerida", "config_ref", "model_ref", "regla", "ventanas", "event_ids", "estado",
    "cerrada_en", "cerrada_por_ventana"
  ],
  "properties": {
    "schema": {"const": "p6.alerta.v1"},
    "alert_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "rule_id": {"type": "string"},
    "run_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "severidad": {"enum": ["info", "advertencia", "critica"]},
    "motivo": {"type": "string", "minLength": 1},
    "accion_sugerida": {"type": "string", "minLength": 1},
    "config_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "regla": {"type": "object"},
    "ventanas": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["indice", "inicio_ms", "fin_ms", "n_candidatas", "n_baja", "proporcion_baja"],
        "properties": {
          "indice": {"type": "integer"},
          "inicio_ms": {"type": "number"},
          "fin_ms": {"type": "number"},
          "n_candidatas": {"type": "integer"},
          "n_baja": {"type": "integer"},
          "proporcion_baja": {"type": "number"}
        }
      }
    },
    "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "estado": {"enum": ["abierta", "cerrada"]},
    "cerrada_en": {"type": ["string", "null"]},
    "cerrada_por_ventana": {"type": ["integer", "null"]}
  }
}
